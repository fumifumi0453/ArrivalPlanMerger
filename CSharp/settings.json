{
  // パスは絶対パスでも、exe を実行したときのカレントフォルダからの相対パスでも書ける
  "InputFolder": "受信",
  "ProcessedFolder": "受信\\処理済",
  "SheetName": "",
  "HeaderRow": 1,

  "OutputColumns": [ "オーダー番号", "品番", "品名", "数量", "入荷予定日" ],
  "OrderNoColumn": "オーダー番号",

  // 残す行の条件（すべて満たす行だけ残す。[] なら全行）
  // Operator: Equals / NotEquals / Contains / NotContains / In / NotIn / Empty / NotEmpty / Regex
  "RowFilters": [
    { "Column": "数量", "Operator": "NotEmpty" },
    { "Column": "区分", "Operator": "In", "Values": [ "入荷", "追加" ] }
  ],

  "OrderRootFolder": "オーダー",
  "CreateOrderFolderIfMissing": true,
  "SplitFileNameFormat": "{order}_{timestamp}.csv",

  // 入荷予定ファイル（Excel）。同じ名前の .csv が既にあれば、初回にその内容を引き継ぐ
  "PlanFileName": "入荷予定.xlsx",
  "PlanSheetName": "入荷予定",
  // 最後の列に追加する最終更新日（行を追加・上書きしたときに現在時刻を入れる）
  "LastUpdatedColumn": "最終更新日",
  "LastUpdatedFormat": "yyyy/MM/dd HH:mm:ss",
  // 最後の列に追加する状態の列。今回のマージで更新しなかった行に CompletedText を入れ、更新した行は空にする
  "StatusColumn": "状態",
  "CompletedText": "完納",
  // 今回のマージで更新しなかった行の背景色（"#RRGGBB"。"" なら色を付けない）
  "UntouchedRowColor": "#D9D9D9",
  "KeyColumns": [ "オーダー番号", "品番" ],

  // マージに使った分割CSVの移動先
  //   "old"      → 各オーダーフォルダの中の old
  //   ".\\old"   → カレントフォルダの old\オーダー番号
  "OldFolder": "old",

  "CsvEncoding": "shift_jis",
  "BackupPlanFile": true
}
